#!/bin/bash
MolecularDynamics
    TimeStep 0.25
    Preserve CenterofMass=Yes Momentum=yes AngularMomentum=No
    Thermostat Type=none
    InitialVelocities Type=Random Temperature=300 RandomVelocitiesMethod=Exact
End

System
    GeometryFile /mnt/workspace/konrad/NaCl_AMS/infentory_120126/infentory/ams/2_run/NaCl/ams_inp/initial.rkf #replace with the actual path
    Charge 0.0
End

Engine ReaxFF
ForceField CHOCsKNaClIFLi.ff
EndEngine

